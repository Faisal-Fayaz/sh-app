{
  "expo": {
    "name": "dev.sh",
    "slug": "sh",
    "description": "A gesture-driven terminal for your own machine, over your own network.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.sh.terminal",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "sh connects to the agent running on your own machine to give you a terminal, so it needs to reach devices on your local network.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSExceptionDomains": {
            "localhost": {
              "NSExceptionAllowsInsecureHTTPLoads": true
            },
            "127.0.0.1": {
              "NSExceptionAllowsInsecureHTTPLoads": true
            },
            "10.0.0.0/8": {
              "NSExceptionAllowsInsecureHTTPLoads": true
            },
            "172.16.0.0/12": {
              "NSExceptionAllowsInsecureHTTPLoads": true
            },
            "192.168.0.0/16": {
              "NSExceptionAllowsInsecureHTTPLoads": true
            },
            "169.254.0.0/16": {
              "NSExceptionAllowsInsecureHTTPLoads": true
            },
            "100.64.0.0/10": {
              "NSExceptionAllowsInsecureHTTPLoads": true
            }
          }
        }
      }
    },
    "android": {
      "package": "dev.sh.terminal",
      "adaptiveIcon": {
        "backgroundColor": "#0b0e14",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "sh uses the camera only to scan the pairing code shown by your own agent."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b0e14",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ]
    ],
    "scheme": "sh",
    "updates": {
      "enabled": false
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "aaa4d057-9db2-40d2-af57-0fc176ba8f9b"
      }
    },
    "owner": "bigp0ppa"
  }
}
