{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": ".verify-build",
    "rootDir": ".",
    "module": "node16",
    "moduleResolution": "node16",
    "target": "es2022",
    "lib": [
      "es2022",
      "dom"
    ],
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "scripts/verify-m2.ts",
    "scripts/test-gestures.ts",
    "scripts/test-palette.ts",
    "scripts/verify-m4.ts",
    "scripts/verify-m5.ts",
    "src/agent/**/*.ts",
    "src/terminal/**/*.ts",
    "src/gestures/**/*.ts",
    "src/storage/onboarding.ts",
    "scripts/test-sessions.ts",
    "scripts/test-pairing.ts",
    "scripts/test-onboarding.ts"
  ],
  "exclude": [
    "node_modules",
    ".verify-build"
  ]
}